      "source": [
        "### Question 리스트 생성하기"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 25,
      "metadata": {
        "id": "9AKOHALL_9rJ"
      },
      "outputs": [],
      "source": [
        "questions = []\n",
        "for sentence in train_data['Q']:\n",
        "  # 구두점 앞뒤를 분리하여 문장을 더 읽기 쉽게 만듭니다\n",
        "  # 예: \"12시땡!\" -> \"12시 땡 !\"\n",
        "  sentence = re.sub(r\"([?.!,])\", r\" \\1 \", sentence)\n",
        "\n",
        "  # 좌우 공백 제거합니다\n",
        "  sentence = sentence.strip()\n",
        "\n",
        "  # 정리된 문장을 질문 리스트에 추가합니다\n",
        "  questions.append(sentence)\n"
      ]
    },
